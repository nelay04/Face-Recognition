# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Secrets & local config ----
.env
.env.*
!.env.example

# ---- Face data (never commit biometric data) ----
# Everything the app writes at runtime lands under data/: enrolment photos,
# the SQLite gallery and its WAL sidecars. Face embeddings are personal data
# and are as identifying as the photo they came from, so the whole directory
# is ignored rather than named file by file. The app creates it on startup.
data/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Stray media anywhere in the tree
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.mp4
*.avi
*.mov
*.pkl
*.npy
# ...except intentional documentation assets
!docs/assets/**

# ---- Logs ----
*.log
logs/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
