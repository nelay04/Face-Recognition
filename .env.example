# Copy to .env and adjust. Never commit .env.

# ---- Service ----
APP_NAME="Face Recognition API"
VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---- Server ----
HOST=127.0.0.1
PORT=8013

# ---- CORS ----
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8013,http://127.0.0.1:8013

# ---- Uploads ----
MAX_UPLOAD_BYTES=5242880         # 5 MiB
MAX_IMAGE_PIXELS=40000000        # guards against decompression bombs
MIN_IMAGE_EDGE=32

# ---- Recognition ----
GALLERY_DB_PATH=data/gallery.db
# Euclidean distance below which two faces are the same person.
# Lower is stricter; 0.6 is dlib's published operating point.
MATCH_TOLERANCE=0.6
# Where detection runs.
#   auto - use the GPU if the installed dlib has CUDA, else fall back to CPU
#   gpu  - require CUDA; refuse to start without it
#   cpu  - force the CPU detector
COMPUTE_DEVICE=auto
# Explicit detector, overriding COMPUTE_DEVICE's choice. Leave unset to follow
# the device: cnn on GPU, hog on CPU.
# DETECTION_MODEL=hog            # hog (CPU, fast) | cnn (GPU, accurate)
DETECTION_UPSAMPLE=1             # higher finds smaller faces, costs time
DETECTION_MAX_EDGE=640           # shrink to this before detecting; 0 disables
ENCODING_MODEL=large             # small (5-point align, fast) | large (68-point, accurate)
ENCODING_JITTERS=1               # averaging passes per live frame; higher is slower
ENROLMENT_JITTERS=10             # averaging passes when enrolling; paid once per person
